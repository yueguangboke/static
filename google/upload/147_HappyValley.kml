				<heading>-0.04132869838043479</heading>
			</LookAt>
			<styleUrl>#default0_copy0</styleUrl>
			<Point>
				<coordinates>113.9752566880012,22.5446493170152,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>欢乐谷卡通城</name>
			<description><![CDATA[卡通城.
<a href="http://www.flickr.com/photos/williamlong/282189406/" title="Photo Sharing"><img src="http://static.flickr.com/90/282189406_cbc247e28b_o.jpg" width="500" height="375" alt="katongcheng" /></a>]]></description>
			<LookAt>
				<longitude>113.9766914162358</longitude>
