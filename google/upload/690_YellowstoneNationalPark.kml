						<heading>0</heading>
						<Icon>
							<href>http://maps.google.com/mapfiles/kml/pal4/icon47.png</href>
						</Icon>
					</IconStyle>
				</Style>
				<Point>
					<coordinates>-110.8378575418569,44.52499504135463,2258.780536525048</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Great Fountain Geyser</name>
				<description>The only predicted geyser in Lower Geyser Basin, Great Fountain Geyser, Great Fountain&apos;s eruption is grand, erupting from a large, terraced platform with massive bursts exploding up to 150 feet high. It is the only predicted geyser in Yellowstone National Park that you can drive to and watch from the car.</description>
				<View>
					<longitude>-110.8000322634271</longitude>
					<latitude>44.5363867485247</latitude>
					<range>2649.499934365968</range>
					<tilt>0</tilt>
					<heading>-2.135658673975283</heading>
				</View>
				<styleUrl>#default+nicon=http://maps.google.com/mapfiles/kml/pal3/icon63.png+hicon=http://maps.google.com/mapfiles/kml/pal3/icon55.png</styleUrl>
				<Style>
