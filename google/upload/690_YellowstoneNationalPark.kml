					<coordinates>-110.3949919626477,44.90648041178034,1983.594396959218</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Tower Campground</name>
				<View>
					<longitude>-110.3899757966727</longitude>
					<latitude>44.8928467276051</latitude>
					<range>3676.95516079451</range>
					<tilt>0</tilt>
