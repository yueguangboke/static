					<coordinates>-110.7066775977776,44.71993086051563,2350.133407054183</coordinates>
				</Point>
			</Placemark>
			<Placemark>
				<name>Norris Campground</name>
				<View>
					<longitude>-110.6924982087884</longitude>
					<latitude>44.73856773169675</latitude>
					<range>2822.082364980247</range>
