			<coordinates>102.0280833333333,28.24431388888889,0</coordinates>
		</Point>
	</Placemark>
	<Placemark>
		<name>种子岛航天中心</name>
		<visibility>0</visibility>
		<description>种子岛航天中心位于日本本土最南部种子岛南端，建成于1974年，主要用于发射试验卫星和应用卫星。</description>
		<LookAt id="khLookAt778">
			<longitude>130.9838611111111</longitude>
			<latitude>30.401575</latitude>
			<altitude>0</altitude>
			<range>20000</range>
			<tilt>4.599010380019678e-011</tilt>
