					</Style>
					<Point>
						<coordinates>108.9712252070167,34.26310923444262,0</coordinates>
					</Point>
				</Placemark>
				<Placemark>
					<name>广仁寺</name>
					<description>创建于清康熙四十四年(1705年)，西安地区唯一的一座藏传佛教寺院，1983年被国务院列为汉族地区佛教全国重点寺院。</description>
					<LookAt>
						<longitude>108.9212733648186</longitude>
						<latitude>34.27590226335967</latitude>
						<altitude>0</altitude>
						<range>378.9242930533707</range>
