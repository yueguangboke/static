	<Folder>
		<name>Places in Hong Kong</name>
		<open>1</open>
		<description>General View of Hong Kong</description>
		<Placemark>
			<name>Wong Tai Sin Temple</name>
			<description>A famous tample for the chinese Goddess - Wong Tai Sin. Every 2nd day of the Lunar new year, people are here for the wish of the coming year.</description>
			<LookAt>
				<longitude>114.1933870369799</longitude>
				<latitude>22.34237338610132</latitude>
				<altitude>0</altitude>
				<range>819.8001128436467</range>
				<tilt>0</tilt>
				<heading>0.008531965638681718</heading>
			</LookAt>
			<styleUrl>#khStyle621</styleUrl>
			<Style>
				<IconStyle>
					<Icon>
						<href>http://maps.google.com/mapfiles/kml/pal4/icon38.png</href>
					</Icon>
				</IconStyle>
			</Style>
			<Point>
				<coordinates>114.1936106262937,22.34225845580803,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Sam Mun Tsai</name>
			<description>Ride a bike or take a bus from TaiPo (DaiPo in this map), you can reach this good place for BBQ. With a great view of Tolo Harbour, and Hong Kong&apos;s most important water supply - man-made fresh water lake. You can walk on the dam and enjoy the fresh air.</description>
			<LookAt>
				<longitude>114.2192906456873</longitude>
				<latitude>22.45393064102116</latitude>
				<altitude>0</altitude>
				<range>11397.52085868393</range>
				<tilt>55.72755424691089</tilt>
				<heading>-161.3340400070195</heading>
			</LookAt>
			<styleUrl>#khStyle692</styleUrl>
			<Point>
				<coordinates>114.2331174515439,22.47133472308851,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Tolo Harbour</name>
			<description>Beautiful environment protected harbour. Excellent for bike riders to travel along.</description>
			<LookAt>
				<longitude>114.2157022246158</longitude>
				<latitude>22.4298867657277</latitude>
				<altitude>0</altitude>
				<range>10106.51424747262</range>
				<tilt>0</tilt>
				<heading>2.785577186443982</heading>
			</LookAt>
			<styleUrl>#khStyle692</styleUrl>
			<Point>
				<coordinates>114.2061674153571,22.43498755388659,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Shing Mun River</name>
			<description>It was not a river, it was the coastal area of shatin. Being reclaimed so much, it becomes a river. You can hire a bicycle at the riverside and ride to Tai Po on the cycling track along Tolo harbour. It is a 1.5-2 hour ride.</description>
			<LookAt>
				<longitude>114.1950478488919</longitude>
				<latitude>22.38453151392201</latitude>
				<altitude>0</altitude>
				<range>2598.681142809943</range>
				<tilt>46.81114551091061</tilt>
				<heading>4.861428082853264</heading>
			</LookAt>
			<styleUrl>#khStyle692</styleUrl>
			<Point>
				<coordinates>114.1948988584816,22.38446498989933,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Shatin Racecourse</name>
			<description>Another place for you to put your bet on the horses. And also the Penfold Park is located inside the Racecourse.</description>
